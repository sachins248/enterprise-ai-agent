# Gemini API Key — get yours free at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL
POSTGRES_PASSWORD=your-secure-password-here

# JWT Secret — generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-at-least-64-chars-here

# GitHub webhook secret — set this in GitHub repo Settings → Secrets too (as GITHUB_WEBHOOK_SECRET)
# Leave blank to skip signature verification during local dev
GITHUB_WEBHOOK_SECRET=

# Redis (optional password — leave blank for no auth in dev)
# REDIS_PASSWORD=

# Service ports (optional — defaults shown)
# GATEWAY_PORT=8080
# AUTH_PORT=8081
# AGENT_PORT=8082
# AUDIT_PORT=8083
# ANALYTICS_PORT=8084
