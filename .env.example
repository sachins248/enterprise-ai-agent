# Copy this file to .env and fill in real values (the real .env is never committed)

# Gemini API Key — get yours free at https://aistudio.google.com/
# The key that lets the agent service use the Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL
# The database password (pick a strong one)
POSTGRES_PASSWORD=your-secure-password-here

# JWT Secret — generate with: openssl rand -base64 64
# The secret that signs login tokens (all services must use the same one)
JWT_SECRET=your-jwt-secret-at-least-64-chars-here

# GitHub webhook secret — set this in GitHub repo Settings → Secrets too (as GITHUB_WEBHOOK_SECRET)
# Leave blank to skip signature verification during local dev
# The shared secret used to check that webhooks really came from GitHub
GITHUB_WEBHOOK_SECRET=

# Redis (optional password — leave blank for no auth in dev)
# Uncomment and set this to give Redis a password
# REDIS_PASSWORD=

# Service ports (optional — defaults shown)
# The port for the gateway (the one you call from outside)
# GATEWAY_PORT=8080
# The port for the auth service
# AUTH_PORT=8081
# The port for the agent service
# AGENT_PORT=8082
# The port for the audit service
# AUDIT_PORT=8083
# The port for the analytics service
# ANALYTICS_PORT=8084
